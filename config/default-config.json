    "Default": 1,
    "CapeDeerHide": 1,
    "CapeTrollHide": 2,
    "CapeWolf": 3,
    "CapeLox": 4,
    "CapeLinen": 4,
    "CapeFeather": 4,
    "CapeAsh": 5,
    "CapeAsksvin": 5,
    "CapeDeepNorth": 6,
    "CapeDeepNorthMage": 6,
    "CapeOD": 7
  },
  "_comment_TierMultiplier": "How much of a treatment's potential each cloak tier realises. Scales numeric effect strength (speed, fall damage, armour...). Tier 6 goes past full potential. Resistance-type effects use ResistanceByTier below.",
  "TierMultiplier": {
    "1": 0.6,
    "2": 0.7,
    "3": 0.8,
    "4": 0.9,
    "5": 1.0,
    "6": 1.15,
    "7": 1.4
  },
  "_comment_ResistanceByTier": "For damage-resistance treatments (Toxin Ward, Frostbound, Emberbound). Valid: SlightlyResistant, Resistant, VeryResistant, Immune.",
  "ResistanceByTier": {
    "1": "SlightlyResistant",
    "2": "SlightlyResistant",
    "3": "Resistant",
    "4": "Resistant",
    "5": "VeryResistant",
    "6": "VeryResistant",
    "7": "Immune"
  },
