<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Cloakcraft</RootNamespace>
    <AssemblyName>Cloakcraft</AssemblyName>
    <Version>0.7.5</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build</OutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Game and BepInEx assemblies. Copy them from your install into lib/ (see README). -->
    <GameLibDir>lib</GameLibDir>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**;lib/**;build/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameLibDir)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameLibDir)/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(GameLibDir)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(GameLibDir)/assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(GameLibDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameLibDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameLibDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameLibDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameLibDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameLibDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameLibDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GameLibDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameLibDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameLibDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameLibDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameLibDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config/default-config.json" LogicalName="Cloakcraft.default-config.json" />
    <EmbeddedResource Include="assets/icons/*.png" LogicalName="Cloakcraft.icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
